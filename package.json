{
  "name": "oas-design-templates",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:mobile": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "bash scripts/build-apk.sh",
    "desktop:dev": "ELECTRON_START_URL=http://localhost:8080 electron .",
    "desktop:build": "vite build --mode electron && electron-packager . \"OAS Production\" --overwrite --out=electron-release --ignore=\"^/src\" --ignore=\"^/public\" --ignore=\"^/android\" --ignore=\"^/electron-release\"",
    "android:icons": "npx --yes @capacitor/assets@3 generate --android --iconBackgroundColor '#0b1220' --iconBackgroundColorDark '#0b1220' --splashBackgroundColor '#0b1220' --splashBackgroundColorDark '#0b1220'",
    "android:apk:release": "bash scripts/build-apk.sh release",
    "android:apk:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-apk.ps1"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/barcode-scanner": "^3.1.0",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/react": "^8.8.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ionicons": "^8.0.13",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.541.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@electron/packager": "^20.0.4",
    "@lovable.dev/vite-plugin-dev-server-bridge": "^1.0.2",
    "@lovable.dev/vite-plugin-hmr-gate": "^1.3.4",
    "@tailwindcss/typography": "^0.5.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "electron": "^43.2.0",
    "lovable-tagger": "^1.3.3",
    "playwright": "^1.62.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  },
  "main": "electron/main.cjs"
}
